# ============ Project ============
PROJECT_NAME=otakutory-backend
ENVIRONMENT=development
DEBUG=true
PORT=8000

# ============ SSL ============
SSL_VERIFY=false  # Set to false for development (true for production)

# ============ Databases ============
# Neon PostgreSQL (asyncpg)
NEON_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/main

# MongoDB (for logs + L2 cache)
MONGODB_CONNECTION_URI=mongodb://admin:admin@localhost:27017
MONGODB_DATABASE_NAME=logs
MONGODB_CACHE_DATABASE_NAME=cache
MONGODB_CACHE_COLLECTION_NAME=cache_entries

# ============ Upstash Redis (Rate Limiting + L1 Cache + Deduplication) ============
REDIS_URL=redis://default:your_password@your-upstash-host:6379

# ============ Security & JWT ============
JWT_SECRET_KEY=your-very-secure-secret-key-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============ Feature Flags ============
ENABLE_AUTH=true
ENABLE_PROFILE=true
ENABLE_ANIME=true
ENABLE_MANGA=true
ENABLE_MUSIC=false
ENABLE_NEWS=false

# ====================================================================
# 1. INTERNAL RATE LIMITING (Protect your own endpoints)
#    Pattern: RATE_LIMIT_<MODULE>_<ENDPOINT>_LIMIT
#            RATE_LIMIT_<MODULE>_<ENDPOINT>_WINDOW (seconds)
# ====================================================================

# ---------- Auth Module ----------
RATE_LIMIT_AUTH_LOGIN_LIMIT=5
RATE_LIMIT_AUTH_LOGIN_WINDOW=60

RATE_LIMIT_AUTH_LOGIN_IP_LIMIT=20
RATE_LIMIT_AUTH_LOGIN_IP_WINDOW=60

RATE_LIMIT_AUTH_REGISTER_LIMIT=3
RATE_LIMIT_AUTH_REGISTER_WINDOW=60

RATE_LIMIT_AUTH_PASSWORD_RESET_LIMIT=3
RATE_LIMIT_AUTH_PASSWORD_RESET_WINDOW=3600

RATE_LIMIT_AUTH_REFRESH_LIMIT=10
RATE_LIMIT_AUTH_REFRESH_WINDOW=60

# ---------- Profile Module ----------
RATE_LIMIT_PROFILE_GET_LIMIT=60
RATE_LIMIT_PROFILE_GET_WINDOW=60

RATE_LIMIT_PROFILE_UPDATE_LIMIT=30
RATE_LIMIT_PROFILE_UPDATE_WINDOW=60

RATE_LIMIT_PROFILE_DELETE_LIMIT=3
RATE_LIMIT_PROFILE_DELETE_WINDOW=60

RATE_LIMIT_PROFILE_CREATE_LIMIT=3
RATE_LIMIT_PROFILE_CREATE_WINDOW=60

RATE_LIMIT_PROFILE_AVATAR_LIMIT=10
RATE_LIMIT_PROFILE_AVATAR_WINDOW=60

RATE_LIMIT_PROFILE_BANNER_LIMIT=5
RATE_LIMIT_PROFILE_BANNER_WINDOW=60

# ---------- Anime Module (Future) ----------
# RATE_LIMIT_ANIME_SEARCH_LIMIT=30
# RATE_LIMIT_ANIME_SEARCH_WINDOW=60
# RATE_LIMIT_ANIME_SEASONAL_LIMIT=10
# RATE_LIMIT_ANIME_SEASONAL_WINDOW=60
# RATE_LIMIT_ANIME_DETAILS_LIMIT=60
# RATE_LIMIT_ANIME_DETAILS_WINDOW=60

# ---------- Manga Module (Future) ----------
# RATE_LIMIT_MANGA_SEARCH_LIMIT=30
# RATE_LIMIT_MANGA_SEARCH_WINDOW=60
# RATE_LIMIT_MANGA_DETAILS_LIMIT=60
# RATE_LIMIT_MANGA_DETAILS_WINDOW=60

# ---------- Music Module (Future) ----------
# RATE_LIMIT_MUSIC_SEARCH_LIMIT=20
# RATE_LIMIT_MUSIC_SEARCH_WINDOW=60
# RATE_LIMIT_MUSIC_PREVIEW_LIMIT=50
# RATE_LIMIT_MUSIC_PREVIEW_WINDOW=60

# ---------- News Module (Future) ----------
# RATE_LIMIT_NEWS_LATEST_LIMIT=30
# RATE_LIMIT_NEWS_LATEST_WINDOW=60
# RATE_LIMIT_NEWS_ENCYCLOPEDIA_LIMIT=20
# RATE_LIMIT_NEWS_ENCYCLOPEDIA_WINDOW=60

# ====================================================================
# 2. EXTERNAL API CONFIGURATIONS (Rate Limits + Caching)
#    Pattern: <API>_BASE_URL
#             <API>_RATE_LIMIT   (requests per time window)
#             <API>_RATE_WINDOW  (seconds)
#             <API>_CACHE_TTL_L1 (Redis TTL in seconds)
#             <API>_CACHE_TTL_L2 (MongoDB TTL in seconds, 0 = no storage)
# ====================================================================

# ---------- AniList (Anime + Manga) ----------
ANILIST_GRAPHQL_URL=https://graphql.anilist.co
ANILIST_RATE_LIMIT=90
ANILIST_RATE_WINDOW=60
ANILIST_CACHE_TTL_L1=300
ANILIST_CACHE_TTL_L2=0

# ---------- Deezer (Music) ----------
DEEZER_BASE_URL=https://api.deezer.com
DEEZER_RATE_LIMIT=50
DEEZER_RATE_WINDOW=5
DEEZER_CACHE_TTL_L1=300
DEEZER_CACHE_TTL_L2=0

# ---------- ANN (News) ----------
ANN_BASE_URL=https://cdn.animenewsnetwork.com/encyclopedia/api.xml
ANN_RATE_LIMIT=0          # 0 = no limit (but respect caching)
ANN_RATE_WINDOW=1
ANN_CACHE_TTL_L1=21600
ANN_CACHE_TTL_L2=604800

# ====================================================================
# 3. INFRASTRUCTURE / PERFORMANCE
# ====================================================================
DEDUP_WINDOW_MS=100                     # Request deduplication window
CACHE_PREFIX_RATE_LIMIT=rate_limit
CACHE_PREFIX_L1=l1
CACHE_PREFIX_L2=l2
CACHE_PREFIX_DEDUP=dedup

# ====================================================================
# 4. FUTURE MICROSERVICES (URLs for internal communication)
# ====================================================================
# SERVICE_AUTH_URL=http://auth-service:8001
# SERVICE_PROFILE_URL=http://profile-service:8002
# SERVICE_ANIME_URL=http://anime-service:8003
# SERVICE_MANGA_URL=http://manga-service:8004
# SERVICE_MUSIC_URL=http://music-service:8005
# SERVICE_NEWS_URL=http://news-service:8006
# SERVICE_LOGGING_URL=http://logging-service:8007
# SERVICE_API_GATEWAY_URL=http://api-gateway:8000
