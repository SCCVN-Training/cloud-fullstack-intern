# ============ Project ============
PROJECT_NAME=otakutory-backend
ENVIRONMENT=development
DEBUG=true
PORT=8000

# ============ Neon PostgreSQL (asyncpg driver) ============
# Format: postgresql+asyncpg://user:password@host:port/database
NEON_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/main

# ============ MongoDB (async driver) ============
MONGODB_CONNECTION_URI=mongodb://admin:admin@localhost:27017
MONGODB_DATABASE_NAME=logs

# ============ Security & JWT ============
JWT_SECRET_KEY=your-very-secure-secret-key-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============ Feature Flags ============
# These let you enable/disable modules without changing code
ENABLE_AUTH=true
ENABLE_PROFILE=true
ENABLE_ANIME=false      # Set to true when you build this module
ENABLE_MANGA=false      # Set to true when you build this module
ENABLE_MUSIC=false      # Set to true when you build this module

# BELOW ARE SETTINGS FOR MICROSERVICES APPROACH

# # ============ Service URLs (for internal communication) ============
# SERVICE_AUTH_URL=http://auth-service:8001
# SERVICE_PROFILE_URL=http://profile-service:8002
# SERVICE_ANIME_URL=http://anime-service:8003
# SERVICE_MANGA_URL=http://manga-service:8004
# SERVICE_MUSIC_URL=http://music-service:8005
# SERVICE_LOGGING_URL=http://logging-service:8006
# SERVICE_API_GATEWAY_URL=http://api-gateway:8000
