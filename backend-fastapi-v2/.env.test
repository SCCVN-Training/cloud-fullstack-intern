# .env.test - Test environment configuration
ENVIRONMENT=test
DEBUG=True

# ============ Test PostgreSQL (Neon) ============
# Use a SEPARATE database on the same cluster
NEON_DATABASE_URL=postgresql+asyncpg://user:pass@ep-cool-bird-123456.us-east-1.aws.neon.tech/main_test

# ============ Test MongoDB (Atlas) ============
# Use a SEPARATE database name
MONGODB_CONNECTION_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DATABASE_NAME=test_logs  # <-- Different from production!

# ============ Test Redis (Upstash) ============
# Use the same URL but different key prefix
REDIS_URL=rediss://default:pass@your-upstash-url:6379
CACHE_PREFIX_RATE_LIMIT=test_rate_limiter  # <-- Different prefix!

# ============ JWT (Same as production - fine) ============
JWT_SECRET_KEY=your_test_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
