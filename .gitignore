# =========================
# System and Editor Files
# =========================
.vscode/
.idea/
.DS_Store

# =========================
# Terraform (CRITICAL SECURITY)
# =========================
# Prevent AWS credentials, states, and plugin binaries from being leaked
**/.terraform/
**/.terraform.*
*.tfstate
*.tfstate.backup
*.tfvars
*.tfvars.json
crash.log

# =========================
# Python & Microservices
# =========================
# Prevent pushing heavy environments and secrets
**/.venv/
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/
**/.env
**/.env.secrets
**/.env.local
# Note: Do not ignore .env.example or .env.shared so others know the template

# =========================
# Frontend Angular
# =========================
**/node_modules/
**/dist/
**/.angular/
**/coverage/

# =========================
# Legacy/Obsolete Folders
# =========================
# Ignore these until senpai is brave enough to delete them permanently
old-workflows/
backend-fastapi/
backend-fastapi-v2/
