# Copy this file to .env and fill in real values. Never commit .env.

# Point this at your Neon Postgres project. Uses psycopg (v3) async —
# match your DATABASE_URL's driver prefix to what's actually installed
# (see requirements.txt): postgresql+psycopg_async for psycopg,
# postgresql+asyncpg for asyncpg. Don't mix them up.
#
# Schema separation does NOT need "?options=-csearch_path=identity" in
# the URL — Neon's pooled (-pooler) endpoint runs PgBouncer in
# transaction mode, which does not reliably honor search_path (Neon's
# own docs confirm this). Instead, app/core/database.py sets
# schema="identity" directly on SQLAlchemy's Base metadata, which
# fully-qualifies every table reference regardless of pooler behavior.
# Just point this at your normal Neon connection string as-is — no
# special query params needed for the schema split.
DATABASE_URL=postgresql+psycopg_async://user:password@host/skillverse

# Must be IDENTICAL to marketplace-service's SECRET_KEY — both services
# verify the same JWT independently (stateless auth). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-real-secret-shared-with-marketplace-service
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

TRAINING_API_KEY=demo-key-123

MEDIA_ROOT=media
MEDIA_URL_BASE=http://localhost:8001/media

# --- Avatar storage backend (Week 6) ---
# "local" (default, above two vars apply) or "s3". When "s3", the two
# vars above are ignored — avatars go to the bucket below instead.
# See app/core/storage.py and the Week 6 guide's S3 section.
STORAGE_BACKEND=local
S3_BUCKET_NAME=
S3_REGION=ap-southeast-1

# --- AWS Secrets Manager (Week 6) ---
# When true, SECRET_KEY/DATABASE_URL/etc above are IGNORED — they're
# fetched from Secrets Manager instead and override whatever's in this
# file. Leave false for local dev without an AWS account configured.
# See app/core/aws_secrets.py and the Week 6 guide.
USE_AWS_SECRETS=false
AWS_SECRET_NAME=skillverse/identity-service
AWS_REGION=ap-southeast-1

# --- AWS credentials (Week 6) ---
# Only needed if STORAGE_BACKEND=s3 or USE_AWS_SECRETS=true. NEVER use
# your AWS root account's keys — create a dedicated IAM user scoped to
# only this project's bucket/secret (see the guide's IAM policy JSON).
# boto3 also reads these from `aws configure`'s credentials file
# automatically — prefer that over putting keys in .env when possible.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
