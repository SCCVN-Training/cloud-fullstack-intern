# Copy this file to .env and fill in real values. Never commit .env.

# Point this at your Neon Postgres project — a DIFFERENT schema than
# identity-service's, but the SAME connection string is fine (schema
# separation happens in app/core/database.py's Base metadata, not the
# URL — see identity-service/.env.example for the full explanation of
# why "?options=-csearch_path=" isn't used here).
DATABASE_URL=postgresql+psycopg_async://user:password@host/skillverse

# Must be IDENTICAL to identity-service's SECRET_KEY (see that service's
# .env.example for why).
SECRET_KEY=change-me-to-a-real-secret-shared-with-identity-service
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

TRAINING_API_KEY=demo-key-123

# Where this service reaches identity-service for the internal public-
# profile lookup (app/clients/identity_client.py).
IDENTITY_SERVICE_URL=http://localhost:8001

# --- AWS Secrets Manager (Week 6) ---
# When true, SECRET_KEY/DATABASE_URL/etc above are IGNORED — they're
# fetched from Secrets Manager instead and override whatever's in this
# file. Leave false for local dev without an AWS account configured.
# See app/core/aws_secrets.py and the Week 6 guide.
USE_AWS_SECRETS=false
AWS_SECRET_NAME=skillverse/marketplace-service
AWS_REGION=ap-southeast-1

# --- AWS credentials (Week 6) ---
# Only needed if USE_AWS_SECRETS=true. NEVER use your AWS root
# account's keys — create a dedicated IAM user scoped to only this
# secret (see the guide's IAM policy JSON). boto3 also reads these from
# `aws configure`'s credentials file automatically — prefer that over
# putting keys in .env when possible.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
